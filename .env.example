# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hostly:hostly@localhost:5433/hostly
# Long random string in production (openssl rand -hex 32)
JWT_SECRET=dev-only-secret-change-me-please
JWT_TTL_HOURS=336
# Public URL of the app (used in guest email links)
APP_URL=http://localhost:5173
# Origins allowed to call the API with cookies (comma separated). In production: your domain.
CORS_ORIGIN=http://localhost:5173
# true behind HTTPS (Cloudflare)
COOKIE_SECURE=false
# Production: serve the built SPA from the API (e.g. apps/web/dist). Empty in dev.
WEB_DIST=

# --- Personal data encryption (required in production) ---
# Guest and staff names, phones, emails, notes are encrypted (AES-256-GCM) in the database.
# Generate each key with: openssl rand -base64 32
# DATA_ENCRYPTION_KEYS is "id:key[,id:key]"; to rotate, append a new key, set DATA_ENCRYPTION_KEY_ID to it,
# and run `pnpm db:migrate` (re-encrypts). Keep old keys listed until that finishes.
# Back these keys up separately: without them the data cannot be read.
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_KEY_ID=
# Separate key for searchable indexes. Changing it requires re-indexing (pnpm db:migrate does it).
BLIND_INDEX_KEY=

# --- Email (SMTP or Resend SMTP: host smtp.resend.com, user "resend", pass = API key) ---
# Web Push for staff devices: `npx web-push generate-vapid-keys`. Empty = built-in dev keys
# outside production; in production, push is off until these are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hostly.app

# Leave SMTP_HOST empty to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hostly <no-reply@example.com>
REMINDERS_ENABLED=true

# --- Public widget ---
PUBLIC_RATE_LIMIT_PER_MIN=20

# --- Seed ---
SEED_SLUG=restoran
SEED_NAME=Restoran
SEED_PASSWORD=hostly123
